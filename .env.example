# Base de datos: Redis Cloud (REDIS_URL). Sin REDIS_URL la app anda igual
# pero los menús se guardan solo en el navegador.
REDIS_URL=redis://default:PASS@HOST:PORT
# Secreto para firmar sesiones (cadena larga aleatoria). En Vercel: env var.
APP_SECRET=cambia-esto-por-algo-largo-y-aleatorio
# Modo IA (opcional). Clave gratis: https://console.groq.com/keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
